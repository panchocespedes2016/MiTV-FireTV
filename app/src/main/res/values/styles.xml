<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MiTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <!-- The base theme is light, so system AlertDialogs (Settings
             actions, player track picker) came out white; force them
             dark. Both namespaces: android.app and androidx builders. -->
        <item name="android:alertDialogTheme">@style/Theme.MiTV.AlertDialog</item>
        <item name="alertDialogTheme">@style/Theme.MiTV.AlertDialog</item>
    </style>
    <style name="Theme.MiTV.AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="Theme.MiTV.Fullscreen" parent="Theme.MiTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
