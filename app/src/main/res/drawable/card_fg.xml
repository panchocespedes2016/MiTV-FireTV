<?xml version="1.0" encoding="utf-8"?>
<!-- Border-only foreground for poster/logo tiles: the image must show through.
     (card_bg is an opaque solid fill and hid every poster when used as foreground.) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="4dp" android:color="@color/accent2" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
