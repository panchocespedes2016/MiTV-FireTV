<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="never"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC101012"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingTop="12dp"
        android:paddingRight="40dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/osdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osdSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPlay"
                style="@style/PlayerBtn"
                android:text="⏸ Pausa" />
            <TextView
                android:id="@+id/btnBack10"
                style="@style/PlayerBtn"
                android:text="⏪ −10s" />
            <TextView
                android:id="@+id/btnFwd10"
                style="@style/PlayerBtn"
                android:text="⏩ +10s" />
            <TextView
                android:id="@+id/timeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/btnAudio"
                style="@style/PlayerBtn"
                android:text="🔊 Audio" />
            <TextView
                android:id="@+id/btnSubs"
                style="@style/PlayerBtn"
                android:text="💬 Subtítulos" />
            <TextView
                android:id="@+id/btnAspect"
                style="@style/PlayerBtn"
                android:text="🖥 Aspecto" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
